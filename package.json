{
  "name": "@roaming-ai/react-streaming",
  "version": "0.1.1",
  "description": "React components, hooks, and pluggable effects for sequential streaming UI.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/localSummer/react-streaming"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=16.8.0 <20"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "12.1.5",
    "@testing-library/react-hooks": "8.0.1",
    "@types/react": "16.14.62",
    "@types/react-dom": "16.9.25",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "8.57.1",
    "jsdom": "24.1.3",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "storybook": "10.6.0",
    "tsup": "8.5.0",
    "typescript": "5.7.3",
    "vite": "7.1.4",
    "vitest": "2.1.9"
  }
}
